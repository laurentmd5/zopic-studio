PROJECT_NAME="ZoPic Studio"
API_V1_STR="/api/v1"
SECRET_KEY="supersecretkey-change-it-in-production"
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# PostgreSQL
DATABASE_URL="postgresql+asyncpg://postgres:postgres@db:5432/zopic"

# Redis
REDIS_URL="redis://redis:6379/0"

# Cloudflare R2 / MinIO (Stockage)
S3_ENDPOINT_URL="http://minio:9000" # R2: https://<account_id>.r2.cloudflarestorage.com
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="zopic-storage"
S3_REGION="auto" # or us-east-1 for MinIO

# Qdrant
QDRANT_URL="http://qdrant:6333"

# Email OTP
SMTP_TLS=True
SMTP_PORT=587
SMTP_HOST="smtp.gmail.com"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
EMAILS_FROM_EMAIL="info@zopic.studio"
EMAILS_FROM_NAME="ZoPic Studio"

# PayDunya
PAYMENT_SIMULATION_MODE=False
PAYMENT_WEBHOOK_SECRET="changez-ce-secret-en-prod"
